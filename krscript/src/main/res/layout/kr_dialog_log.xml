<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/dialogRoot"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageButton
        android:id="@+id/btn_hide"
        style="@style/SceneButton"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="8dp"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/kr_hide"
        android:contentDescription="@string/btn_hide" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/btn_hide"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kr_log_status" />

            <TextView
                android:id="@+id/title"
                style="@style/dialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:padding="0dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/kr_log_status"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/kr_log_running"
                android:textColor="@color/kr_shell_log_end"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/desc"
            style="@style/dialogDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="0dp"
            android:paddingTop="2dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <com.omarea.common.ui.OverScrollView
        android:id="@+id/log_scroll"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/kr_log_panel"
        android:clipToPadding="true"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_actions"
        android:layout_below="@id/top_bar">

        <TextView
            android:id="@+id/shell_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/kr_shell_log_basic"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:breakStrategy="simple"
            android:textIsSelectable="true"
            android:padding="12dp" />
    </com.omarea.common.ui.OverScrollView>

    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_copy"
            style="@style/dialogCancelBtn"
            android:layout_weight="1"
            android:text="@string/btn_copy_output" />

        <Button
            android:id="@+id/btn_exit"
            style="@style/dialogConfirmBtn"
            android:layout_weight="1"
            android:text="@string/btn_exit" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/action_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/top_bar"
        android:indeterminate="true"
        android:progress="0" />
</RelativeLayout>
