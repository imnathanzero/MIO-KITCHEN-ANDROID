<?xml version="1.0" encoding="UTF-8" ?>
<page>
    <group title="@string/more_script_executor">
    <action>
        <title>@string/more_script_executor</title>
        <summary>@string/more_custom_command</summary>
        <set>$TO</set>
        <param name="TO" placeholder="@string/more_custom_command" value="" requiret="true" />
    </action>
     </group>
     
     <group>
     <action>
        <title>@string/more_flash_image</title>
        <set>script/tool.sh flash_img</set>
        <param name="CQ" label="@string/more_reboot_after_flash" type="checkbox" />
        <param name="CQ1" label="@string/more_reboot_recovery_after_flash" type="checkbox" />
        <param name="IMG" title="@string/more_partition_size_warning" options-sh="script/tool.sh parts" required="true"/>
        <param name="Brush_in" type="file" suffix="img" editable="true" required="true" title="@string/more_image_path_hint" desc="@string/more_path_no_spaces"/>
    </action>
    <action>
        <title>@string/more_extract_image</title>
        <set>script/tool.sh extract_part</set>
        <param name="IMG" title="@string/more_select_partitions" multiple="true" options-sh="script/tool.sh parts" required="true"/>
    </action>
     </group>
     
       <group> 
        <text>
        <slices>
 <slice size="17" align="center" color="black">@string/more_disclaimer</slice>
 <slice break="true"/>
 <slice color="red" align="center" size="14">@string/more_risk_warning</slice><slice/>
 <slice color="red" align="center" size="14">@string/more_bug_feedback</slice><slice break="true"/>
        </slices>
        </text>
</group>
</page>
