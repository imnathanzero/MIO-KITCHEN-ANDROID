<?xml version="1.0" encoding="UTF-8" ?>
<resource dir="file:///android_asset/script" /> 
<items>
    <group title="@string/home_overview">
     <action reload="true" auto-off="true"> 
     <title>@string/home_project_list</title>
     <param name="xm" options-sh="script/tool.sh check"/>
     <set>echo "$xm" > ${XBJ}</set>
     <summary sh="script/tool.sh zy" />
     </action>
    </group>

    <group title="@string/home_tools">
        <action reload="true" auto-off="true">
            <title>@string/home_download_rom</title>
            <param name="jb" label="@string/home_unpack_after_download" type="switch" />
            <param name="del" label="@string/home_delete_after_unpack" type="switch" />
            <param name="romdz" label="@string/home_input_link" title="@string/home_input_link" placeholder="@string/home_enter_link" type="text" />
            <script>script/tool.sh download</script>
        </action>
        
         <action reload="true" auto-off="true"> 
     <title>@string/home_select_rom</title>
 <set>script/tool.sh UZ</set>
 <param name="del" label="@string/home_delete_source" type="switch" />
<param name="xzrom" label="@string/home_file_selection" type="file" suffix="zip" />
     </action>
     
     <action reload="true" auto-off="true"> 
     <title>@string/home_delete_project</title>
     <param multiple="true" name="xms" options-sh="script/tool.sh check"/>
     <set>script/tool.sh del</set>
     </action>
     
     <action reload="true" auto-off="true"> 
     <title>@string/home_new_project</title>
     <param name="xmmc" label="@string/home_project_name" title="@string/home_enter_project_name" placeholder="@string/home_project_name_placeholder" type="text" />
     <set>script/tool.sh mn</set>
     </action>  
          
    <page title="@string/home_engineering_menu" config="file:///android_asset/script2/mio.xml">
    <set>cd $SH_DIR</set>
    <lock>script/tool.sh unlock</lock>
    </page>
    </group>
</items>
